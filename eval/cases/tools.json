  {
    "server": "homeassistant",
    "name": "HassTurnOn",
    "description": "Switch on, open or activate devices by name, area or floor. On a lock this LOCKS it; on a cover (door, gate, blind) this OPENS it.",
    "input_schema": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the device or entity, as the user said it."
        },
        "area": {
          "type": "string",
          "description": "Area (room) name."
        },
        "floor": {
          "type": "string",
          "description": "Floor name."
        },
        "domain": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Limit to these domains, e.g. light, switch, lock, cover, media_player."
        },
        "device_class": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Limit to these device classes, e.g. door, garage, outlet."
        }
      }
    }
  },
