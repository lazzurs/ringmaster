        "target": {
          "type": "object",
          "description": "What to act on.",
          "properties": {
            "entity_id": {
              "type": "string",
              "description": "Entity id, e.g. light.kitchen_lights."
            },
            "area_id": {
              "type": "string",
              "description": "Area id."
            },
            "device_id": {
              "type": "string",
              "description": "Device id."
            }
          }
        },
        "data": {
          "type": "object",
          "description": "Extra action data, e.g. temperature or brightness_pct."
        }
      },
      "required": [
        "action"
      ]
    }
  },
