    "server": "homeassistant",
    "name": "call_action",
    "description": "Run any Home Assistant action on a target, e.g. light.turn_on, lock.unlock, climate.set_temperature or alarm_control_panel.alarm_arm_away. Use entity ids from GetLiveContext.",
    "input_schema": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "description": "The action as <domain>.<action>."
